<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>FastImageViewer.Tests</RootNamespace>
    <AssemblyName>FastImageViewer.Tests</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="../Fast Image Viewer/Fast Image Viewer.vbproj" GlobalPropertiesToRemove="TargetFrameworks" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Include="../Fast Image Viewer/Core/*.vb" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../Fast Image Viewer/AppGlobals.vb" Link="Production/AppGlobals.vb" />
    <Compile Include="../Fast Image Viewer/Helpers/PathHelper.vb" Link="Production/PathHelper.vb" />
    <Compile Remove="Windows/**/*.vb" />
  </ItemGroup>
</Project>
